     def enterWalk(self, teleportIn = 0):
         self.enterFLM()
+        try:
+            la = base.localAvatar
+            if not (la.isPageDown or la.isPageUp):
+                base.camLens.setFov(la.fov)     # a minigame, shop scene or battle may have left its own view behind
